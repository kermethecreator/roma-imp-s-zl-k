<script>
  function levenshteinMesafesi(a, b) {
    const matris = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0));
    for (let i = 0; i <= a.length; i++) matris[i][0] = i;
    for (let j = 0; j <= b.length; j++) matris[0][j] = j;

    for (let i = 1; i <= a.length; i++) {
      for (let j = 1; j <= b.length; j++) {
        const maliyet = a[i - 1] === b[j - 1] ? 0 : 1;
        matris[i][j] = Math.min(
          matris[i - 1][j] + 1,
          matris[i][j - 1] + 1,
          matris[i - 1][j - 1] + 2 * maliyet
        );
      }
    }
    return matris[a.length][b.length];
  }

  function kelimeAra(secilenKelime = null) {
    const input = document.getElementById("searchInput");
    if (secilenKelime) input.value = secilenKelime;

    const aranan = input.value.trim().toLocaleLowerCase('tr-TR');
    const sonucAlani = document.getElementById("resultCard");

    if (!aranan) {
      sonucAlani.innerHTML = '<p style="color: #a8a29e; text-align: center;">Lütfen bir kelime yazın.</p>';
      return;
    }

    // Kelime sözlükte varsa
    if (sozluk[aranan]) {
      const veri = sozluk[aranan];
      
      // Kod hem sadece metin olan verileri, hem de resimli verileri otomatik anlar
      const anlam = typeof veri === 'object' ? veri.anlam : veri;
      const resim = typeof veri === 'object' ? veri.resim : null;

      // Resim varsa gösterir, link bozuksa veya internet yoksa gizler
      const resimKodu = resim ? `<img src="${resim}" alt="${aranan}" class="word-image" onerror="this.style.display='none'">` : '';

      sonucAlani.innerHTML = `
        <div class="result-content">
          ${resimKodu}
          <div class="text-content">
            <div class="word-title">${aranan}</div>
            <div class="meaning">${anlam}</div>
          </div>
        </div>
      `;
      return;
    }

    // Kelime yoksa benzerleri öner
    const benzerler = Object.keys(sozluk).filter(kelime => {
      const mesafe = levenshteinMesafesi(aranan, kelime);
      const iceriyorMu = kelime.includes(aranan) || aranan.includes(kelime);
      return mesafe <= 3 || iceriyorMu;
    });

    if (benzerler.length > 0) {
      const chipHtml = benzerler.map(k => `<span class="chip" onclick="kelimeAra('${k}')">${k}</span>`).join("");
      sonucAlani.innerHTML = `
        <div class="not-found">"${aranan}" bulunamadı.</div>
        <div class="suggestions-label">Bunu mu demek istediniz?:</div>
        <div class="chips">${chipHtml}</div>
      `;
    } else {
      sonucAlani.innerHTML = `
        <div class="not-found">"${aranan}" bulunamadı.</div>
        <p style="color: #78716c; font-size: 0.95rem;">Sözlükte benzer bir kayıt bulunmuyor.</p>
      `;
    }
  }

  document.getElementById("searchInput").addEventListener("keypress", (e) => {
    if (e.key === "Enter") kelimeAra();
  });
</script>

</body>
</html>
